# Public address of the app (no trailing slash)
APP_URL=https://unchore.ai
# Postgres
DATABASE_URL=postgres://user:pass@host:5432/unchore
# 32 random bytes, base64 — encrypts users' AI keys and saved passwords
UNCHORE_SECRET_KEY=
# Google sign-in (OAuth client: web application; redirect URI = APP_URL/api/auth/google/callback)
UNCHORE_GOOGLE_CLIENT_ID=
UNCHORE_GOOGLE_CLIENT_SECRET=
# E-mail (sign-in links and automation alerts)
RESEND_API_KEY=
MAIL_FROM=Unchore <hello@unchore.ai>
# Shared secret for the scheduler (Vercel Cron / worker)
CRON_SECRET=
# Comma-separated owner e-mails (nightly health report, admin page)
OWNER_EMAILS=
