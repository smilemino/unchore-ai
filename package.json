{
  "name": "unchore",
  "version": "0.1.0",
  "private": true,
  "description": "Unchore — ask anything; if it repeats, Unchore offers to automate it and builds it.",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p ${PORT:-3500}",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "skills": "node scripts/export-skills.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "3.5.1",
    "fflate": "0.8.2",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "4.0.1",
    "unpdf": "1.8.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
